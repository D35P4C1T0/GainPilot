if(NOT DEFINED README_PATH)
  set(README_PATH "${CMAKE_CURRENT_LIST_DIR}/../README.md")
endif()

if(NOT DEFINED IMAGE_PATH)
  set(IMAGE_PATH "docs/assets/gainpilot-ui.png")
endif()

set(BEGIN_MARKER "<!-- gainpilot-ui-snapshot:start -->")
set(END_MARKER "<!-- gainpilot-ui-snapshot:end -->")
set(ANCHOR "## Build Requirements")
set(BLOCK "${BEGIN_MARKER}\n\n## Plugin UI\n\n![GainPilot plugin UI](${IMAGE_PATH})\n\n${END_MARKER}")

file(READ "${README_PATH}" README_CONTENT)

string(FIND "${README_CONTENT}" "${BEGIN_MARKER}" BEGIN_INDEX)
string(FIND "${README_CONTENT}" "${END_MARKER}" END_INDEX)

if(BEGIN_INDEX GREATER_EQUAL 0 AND END_INDEX GREATER BEGIN_INDEX)
  string(LENGTH "${END_MARKER}" END_MARKER_LENGTH)
  math(EXPR AFTER_END_INDEX "${END_INDEX} + ${END_MARKER_LENGTH}")
  string(SUBSTRING "${README_CONTENT}" 0 "${BEGIN_INDEX}" PREFIX)
  string(SUBSTRING "${README_CONTENT}" "${AFTER_END_INDEX}" -1 SUFFIX)
  set(UPDATED_CONTENT "${PREFIX}${BLOCK}${SUFFIX}")
else()
  string(FIND "${README_CONTENT}" "${ANCHOR}" ANCHOR_INDEX)
  if(ANCHOR_INDEX GREATER_EQUAL 0)
    string(SUBSTRING "${README_CONTENT}" 0 "${ANCHOR_INDEX}" PREFIX)
    string(SUBSTRING "${README_CONTENT}" "${ANCHOR_INDEX}" -1 SUFFIX)
    set(UPDATED_CONTENT "${PREFIX}${BLOCK}\n\n${SUFFIX}")
  else()
    set(UPDATED_CONTENT "${README_CONTENT}\n\n${BLOCK}\n")
  endif()
endif()

if(NOT UPDATED_CONTENT STREQUAL README_CONTENT)
  file(WRITE "${README_PATH}" "${UPDATED_CONTENT}")
endif()
